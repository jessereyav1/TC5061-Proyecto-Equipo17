# Copia este archivo como ".env" para cambiar la configuración sin editar docker-compose.yml.
# Si no existe ".env", Compose usa los valores por defecto que aparecen aquí.

# Puertos publicados en tu máquina
API_PORT=8000
MLFLOW_PORT=5000

# Límites de recursos de la API (definen el "tamaño de la instancia" para el análisis FinOps)
API_CPUS=1.0
API_MEM_LIMIT=1g
